+#[cfg(all(test, feature = "impit"))]
+mod grease_tests {
+    use super::grease_codepoint;
+
+    #[test]
+    fn every_seed_produces_one_of_the_sixteen_reserved_values() {
+        let reserved: Vec<u16> = (0..16u16)
+            .map(|n| {
+                let byte = ((n as u8) << 4) | 0x0a;
+                u16::from_be_bytes([byte, byte])
+            })
+            .collect();
+        assert_eq!(reserved[0], 0x0a0a);
+        assert_eq!(reserved[15], 0xfafa);
+        for seed in 0..=u8::MAX {
+            let value = grease_codepoint(seed);
+            assert!(
+                reserved.contains(&value),
+                "seed {seed} produced {value:#06x}, which RFC 8701 does not reserve"
+            );
+            // The shape a GREASE check reads: both bytes equal, low nibble a.
+            let [hi, lo] = value.to_be_bytes();
+            assert_eq!(hi, lo);
+            assert_eq!(hi & 0x0f, 0x0a);
+        }
+    }
+
+    #[test]
+    fn the_sixteen_are_all_reachable() {
+        let mut seen = std::collections::BTreeSet::new();
+        for seed in 0..=u8::MAX {
+            seen.insert(grease_codepoint(seed));
+        }
+        assert_eq!(seen.len(), 16, "some reserved value can never be chosen");
+    }
