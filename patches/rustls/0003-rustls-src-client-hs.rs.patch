+/// One of the sixteen values RFC 8701 reserves, from a byte.
+///
+/// The reserved values are `0x0a0a`, `0x1a1a`, ... `0xfafa`: the high nibble
+/// of each byte counts and the low nibble is always `a`, and both bytes are
+/// the same. Added by this repository; see TODO/cli-surface.md T-263.
+#[cfg(feature = "impit")]
+fn grease_codepoint(seed: u8) -> u16 {
+    let byte = ((seed & 0x0f) << 4) | 0x0a;
+    u16::from_be_bytes([byte, byte])
+}
